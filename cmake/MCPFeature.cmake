function(mcp_add_feature FEATURE_NAME FEATURE_MODE)
    if("${FEATURE_MODE}" STREQUAL "y")
        set(${FEATURE_NAME}_BUILTIN TRUE PARENT_SCOPE)
        set(${FEATURE_NAME}_MODULE FALSE PARENT_SCOPE)
        set(${FEATURE_NAME}_ENABLED TRUE PARENT_SCOPE)
    elseif("${FEATURE_MODE}" STREQUAL "m")
        set(${FEATURE_NAME}_BUILTIN FALSE PARENT_SCOPE)
        set(${FEATURE_NAME}_MODULE TRUE PARENT_SCOPE)
        set(${FEATURE_NAME}_ENABLED TRUE PARENT_SCOPE)
    elseif("${FEATURE_MODE}" STREQUAL "n")
        set(${FEATURE_NAME}_BUILTIN FALSE PARENT_SCOPE)
        set(${FEATURE_NAME}_MODULE FALSE PARENT_SCOPE)
        set(${FEATURE_NAME}_ENABLED FALSE PARENT_SCOPE)
    else()
        message(FATAL_ERROR "Invalid feature mode for ${FEATURE_NAME}: ${FEATURE_MODE}")
    endif()
endfunction()
